#!/bin/sh /etc/rc.common
START=18
STOP=10
USE_PROCD=1

start_service() {
    /usr/libexec/xhs-ipv4-control ensure || return 1
    procd_open_instance monitor
    procd_set_param command /usr/libexec/xhs-ipv4-monitor
    procd_set_param respawn 3600 5 0
    procd_set_param term_timeout 5
    procd_set_param stderr 1
    procd_close_instance
    procd_open_instance maintenance
    procd_set_param command /usr/libexec/xhs-ipv4-control maintain
    procd_set_param respawn 3600 5 0
    procd_set_param term_timeout 5
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    nft delete table inet xhs_ipv4 2>/dev/null || :
}
